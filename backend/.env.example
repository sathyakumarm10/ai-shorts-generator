# Copy this file to backend/.env for local development.
# Never commit backend/.env.

# HTTP / CORS
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=1073741824
UPLOAD_DIR=downloads/uploads
MEDIA_ROOT=outputs
MEDIA_COOKIE_SECURE=false

# Authentication
# Required for safe JWT signing. Generate locally; never reuse this placeholder.
AUTH_JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PBKDF2_ITERATIONS=100000

# Database: local SQLite only
DATABASE_BACKEND=sqlite
DATABASE_URL=
JOB_DB_PATH=data/jobs.sqlite3
USER_DB_PATH=data/users.sqlite3
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5.0
DB_ENABLE_LOCAL_FALLBACK=true

# Background jobs: in-process ThreadPool only
QUEUE_BACKEND=threadpool
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
JOB_QUEUE_NAME=ai_shorts:jobs
JOB_QUEUE_MAX_RETRIES=3
JOB_QUEUE_RETRY_DELAY_SECONDS=2.0
JOB_QUEUE_VISIBILITY_TIMEOUT=300.0
JOB_QUEUE_STALE_SWEEP_INTERVAL=60.0
QUEUE_ENABLE_LOCAL_FALLBACK=true
QUEUE_THREADPOOL_WORKERS=4

# Optional AI highlight selection. Leave keys empty for heuristic fallback.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Storage: local filesystem only
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=ai-shorts-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_EXPIRY=3600
STORAGE_MAX_RETRIES=3
STORAGE_ENABLE_LOCAL_FALLBACK=true

# Hardware / local media processing
ACCELERATION_DEVICE=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
FFMPEG_ACCELERATION=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HF_HOME=model_cache

# Logging
LOG_LEVEL=INFO
JSON_LOGGING=true
