# ==============================================================================
# AI Shorts Generator - Production Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env on your deployment host and fill in production secrets.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins: Comma-separated domains allowed to call the API.
# In a standard single-origin reverse proxy deployment, this can be your public domain.
# Example: ALLOWED_ORIGINS=https://shorts.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# REQUIRED in production: Generate a cryptographically secure random string (minimum 32 characters).
# Example command to generate: openssl rand -hex 32
AUTH_JWT_SECRET=your-secure-random-32-character-secret-key-here

# JWT token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password hashing PBKDF2 iteration count
PBKDF2_ITERATIONS=100000

# ------------------------------------------------------------------------------
# Database Backend (PostgreSQL recommended for production)
# ------------------------------------------------------------------------------
# Selector: "postgres" (recommended) | "sqlite" (dev/single-node fallback)
DATABASE_BACKEND=postgres

# Full PostgreSQL connection URL (takes precedence over individual parameters below)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://ai_shorts:CHANGE_THIS_PASSWORD@postgres:5432/ai_shorts

# Individual PostgreSQL connection parameters (used if DATABASE_URL is not set)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ai_shorts
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=ai_shorts

# SQLite fallback paths (used when DATABASE_BACKEND=sqlite or postgres connection fails)
JOB_DB_PATH=/app/data/jobs.sqlite3
USER_DB_PATH=/app/data/users.sqlite3

# Enable automatic SQLite fallback if PostgreSQL is unreachable (default: true)
DATABASE_ENABLE_LOCAL_FALLBACK=true

# ------------------------------------------------------------------------------
# Job Queue Backend (Redis recommended for production)
# ------------------------------------------------------------------------------
# Selector: "redis" (recommended) | "threadpool" (dev/single-node fallback)
QUEUE_BACKEND=redis

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Name prefix for all queue keys in Redis
JOB_QUEUE_NAME=ai_shorts_jobs

# Maximum number of retry attempts before a job is moved to the dead-letter queue
JOB_QUEUE_MAX_RETRIES=3

# Initial retry delay in seconds (subsequent retries use exponential backoff)
JOB_QUEUE_RETRY_DELAY_SECONDS=30

# Seconds before a processing job is considered stale and recovered
JOB_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# AI Provider Configuration (Highlight & Viral Hook Extraction)
# ------------------------------------------------------------------------------
# Optional: Set your OpenRouter or OpenAI API key to enable LLM highlight ranking.
# If unset, the system automatically falls back to the deterministic heuristic engine.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# Media Storage Backend (Local Filesystem vs AWS S3 / Cloudflare R2 Cloud Storage)
# ------------------------------------------------------------------------------
# Options: "local" (default), "s3", "r2", "minio", or "wasabi"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 configuration (required when STORAGE_BACKEND is s3 or r2)
# Cloudflare R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-shorts-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: Public CDN / Custom Domain Base URL for presigned and direct links
S3_PUBLIC_BASE_URL=

# Presigned URL expiry in seconds (default: 3600 = 1 hour)
S3_PRESIGNED_EXPIRY=3600

# Cloud storage retry attempts and automatic local fallback
STORAGE_MAX_RETRIES=3
STORAGE_ENABLE_LOCAL_FALLBACK=true

# ------------------------------------------------------------------------------
# Hardware Acceleration & GPU Execution (NVIDIA CUDA & FFmpeg NVENC)
# ------------------------------------------------------------------------------
# Primary hardware device mode: "auto" (default), "cuda", or "cpu"
# - "auto": Uses NVIDIA CUDA & NVENC if hardware/drivers are available, with seamless CPU fallback.
# - "cuda": Forces NVIDIA CUDA for Whisper and NVENC for FFmpeg.
# - "cpu":  Forces CPU-only processing (useful for CPU clusters or low-memory nodes).
ACCELERATION_DEVICE=auto

# Whisper Speech-to-Text inference device override: "auto", "cuda", or "cpu"
WHISPER_DEVICE=auto

# Whisper model compute precision: "auto", "float16", "int8_float16", "int8", or "float32"
# Recommended for CUDA: float16 or int8_float16. Recommended for CPU: int8.
WHISPER_COMPUTE_TYPE=auto

# FFmpeg H.264 video encoding acceleration: "auto", "nvenc", or "cpu"
FFMPEG_ACCELERATION=auto
