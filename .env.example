# =====================================================================
# AI Shorts Generator - Environment Variables Example
# Copy this file to .env and fill in the values for local development.
# NEVER commit the actual .env file containing real API keys.
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
MAX_UPLOAD_SIZE_BYTES=1073741824
UPLOAD_DIR=downloads/uploads
MEDIA_ROOT=outputs

# Optional AI LLM Provider Configuration for Intelligent Highlight & Hook Generation
# If left empty or unset, the system automatically falls back to the deterministic heuristic engine.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# REQUIRED in production: set a strong random secret (min 32 chars).
# If unset, a dev-only insecure default is used — NEVER use that in production.
AUTH_JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PBKDF2_ITERATIONS=100000
MEDIA_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Database Backend (PostgreSQL or SQLite)
# ---------------------------------------------------------------------------
# Backend selector: "postgres" | "sqlite" (default: sqlite for local dev)
DATABASE_BACKEND=sqlite

# PostgreSQL connection URL (required when DATABASE_BACKEND=postgres)
# DATABASE_URL=postgresql://ai_shorts:ai_shorts_password@localhost:5432/ai_shorts

# Individual PostgreSQL connection parameters (alternative to DATABASE_URL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=ai_shorts
# POSTGRES_PASSWORD=ai_shorts_password
# POSTGRES_DB=ai_shorts

# SQLite fallback paths (used when DATABASE_BACKEND=sqlite or as fallback)
JOB_DB_PATH=data/jobs.sqlite3
USER_DB_PATH=data/users.sqlite3
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5.0
DB_ENABLE_LOCAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Job Queue Backend (Redis or ThreadPool)
# ---------------------------------------------------------------------------
# Backend selector: "redis" | "threadpool" (default: threadpool for local dev)
QUEUE_BACKEND=threadpool

# Redis connection URL (required when QUEUE_BACKEND=redis)
# REDIS_URL=redis://localhost:6379/0

# Queue configuration
JOB_QUEUE_NAME=ai_shorts:jobs
JOB_QUEUE_MAX_RETRIES=3
JOB_QUEUE_RETRY_DELAY_SECONDS=2.0
JOB_QUEUE_VISIBILITY_TIMEOUT=300.0
JOB_QUEUE_STALE_SWEEP_INTERVAL=60.0
QUEUE_ENABLE_LOCAL_FALLBACK=true
QUEUE_THREADPOOL_WORKERS=4

# ---------------------------------------------------------------------------
# Cloud Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# ---------------------------------------------------------------------------
# Supported backends: "local" (default), "s3", "r2", "minio", "wasabi"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 configuration (required when STORAGE_BACKEND is s3 or r2)
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave empty for standard AWS or specify custom endpoint
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-shorts-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: public CDN/custom domain base URL (e.g., https://media.yourdomain.com)
S3_PUBLIC_BASE_URL=

# Presigned URL expiry in seconds (default: 3600 = 1 hour)
S3_PRESIGNED_EXPIRY=3600

# Cloud storage retry attempts and automatic local fallback
STORAGE_MAX_RETRIES=3
STORAGE_ENABLE_LOCAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Hardware Acceleration & Device Modes (GPU / CPU)
# ---------------------------------------------------------------------------
# Options: "auto" (default - use CUDA/NVENC if available with CPU fallback), "cuda", or "cpu"
ACCELERATION_DEVICE=auto

# Whisper Speech-to-Text inference device override: "auto", "cuda", or "cpu"
WHISPER_DEVICE=auto

# Whisper compute precision: "auto" (float16 for cuda, int8 for cpu), "float16", "int8_float16", "int8", "float32"
WHISPER_COMPUTE_TYPE=auto

# FFmpeg H.264 video encoding acceleration: "auto", "nvenc", or "cpu"
FFMPEG_ACCELERATION=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Model cache location
HF_HOME=model_cache
