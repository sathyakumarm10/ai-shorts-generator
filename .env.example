# =====================================================================
# AI Shorts Generator - Environment Variables Example
# Copy this file to .env and fill in the values for local development.
# NEVER commit the actual .env file containing real API keys.
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional AI LLM Provider Configuration for Intelligent Highlight & Hook Generation
# If left empty or unset, the system automatically falls back to the deterministic heuristic engine.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# REQUIRED in production: set a strong random secret (min 32 chars).
# If unset, a dev-only insecure default is used — NEVER use that in production.
AUTH_JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PBKDF2_ITERATIONS=100000

# Optional: override the default user database path
# USER_DB_PATH=data/users.sqlite3

# ---------------------------------------------------------------------------
# Cloud Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# ---------------------------------------------------------------------------
# Supported backends: "local" (default), "s3", "r2", "minio", "wasabi"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 configuration (required when STORAGE_BACKEND is s3 or r2)
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave empty for standard AWS or specify custom endpoint
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-shorts-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: public CDN/custom domain base URL (e.g., https://media.yourdomain.com)
S3_PUBLIC_BASE_URL=

# Presigned URL expiry in seconds (default: 3600 = 1 hour)
S3_PRESIGNED_EXPIRY=3600

# Cloud storage retry attempts and automatic local fallback
STORAGE_MAX_RETRIES=3
STORAGE_ENABLE_LOCAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Hardware Acceleration & Device Modes (GPU / CPU)
# ---------------------------------------------------------------------------
# Options: "auto" (default - use CUDA/NVENC if available with CPU fallback), "cuda", or "cpu"
ACCELERATION_DEVICE=auto

# Whisper Speech-to-Text inference device override: "auto", "cuda", or "cpu"
WHISPER_DEVICE=auto

# Whisper compute precision: "auto" (float16 for cuda, int8 for cpu), "float16", "int8_float16", "int8", "float32"
WHISPER_COMPUTE_TYPE=auto

# FFmpeg H.264 video encoding acceleration: "auto", "nvenc", or "cpu"
FFMPEG_ACCELERATION=auto

