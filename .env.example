# =====================================================================
# AI Shorts Generator - Environment Variables Example
# Copy this file to .env and fill in the values for local development.
# NEVER commit the actual .env file containing real API keys.
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional AI LLM Provider Configuration for Intelligent Highlight & Hook Generation
# If left empty or unset, the system automatically falls back to the deterministic heuristic engine.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# REQUIRED in production: set a strong random secret (min 32 chars).
# If unset, a dev-only insecure default is used — NEVER use that in production.
AUTH_JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PBKDF2_ITERATIONS=100000

# Optional: override the default user database path
# USER_DB_PATH=data/users.sqlite3

# ---------------------------------------------------------------------------
# Cloud Storage (S3-Compatible)
# ---------------------------------------------------------------------------
# Set STORAGE_BACKEND=s3 to enable cloud storage. Default is "local".
STORAGE_BACKEND=local

# Required when STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ai-shorts-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: public CDN/proxy URL for serving stored objects
S3_PUBLIC_BASE_URL=
